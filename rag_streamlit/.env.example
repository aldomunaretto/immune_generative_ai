# ---------------------------------------------------------------------------
# Copia este fichero a «.env» y rellena la clave.
# Consíguela gratis en https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# --- Modelos (opcional: se pueden cambiar en la barra lateral) --------------
# La app lista en tiempo de ejecución los modelos que tu clave tiene
# disponibles, así que estos valores son solo el punto de partida.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_AUX_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Dimensión del embedding: 128, 256, 512, 768, 1536 o 3072.
# 768 es el mejor equilibrio para un corpus de empresa.
GEMINI_EMBEDDING_DIM=768

# --- Almacenamiento y rendimiento ------------------------------------------
RAG_INDEX_DIR=./indices

# Textos por petición de embeddings. El límite de la API es 250 textos y
# 20.000 tokens por petición; 50 deja margen y evita 429 en el nivel gratuito.
RAG_EMBED_BATCH=50
